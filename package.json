{
  "name": "self-media-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, self-media-only bot powered by the official DeepSeek Harness runtime.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:runtime": "tsx scripts/runtime-smoke.ts",
    "test:real": "tsx scripts/real-model-smoke.ts --allow-paid-api",
    "doctor": "tsx scripts/doctor.ts",
    "audit:prod": "node scripts/audit.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@fastify/multipart": "^9.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "^8.12.2",
    "@modelcontextprotocol/client": "^2.3.0",
    "fflate": "^0.8.3"
  }
}
